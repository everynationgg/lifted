# Server-Side Supabase Edge Functions Environment Secrets
# These variables are only accessible inside Supabase Edge Runtime containers.
# NEVER expose to client applications or mobile bundles.

# Master Kill Switch (Set to "true" only when approved for cloud AI inference; default: false)
CLOUD_AI_ENABLED=false

# Google Gemini API Configuration (Supported models: gemini-2.5-flash, gemini-2.5-flash-lite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Local / Production Service Role (for authoritative quota enforcement)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Allowed Web Origins (comma-separated for CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost
