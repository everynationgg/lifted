# LIFTED Environment Variables Configuration Reference
# ====================================================

# Client-Side Supabase Configuration (Phase 6 & 7)
# ------------------------------------------------
# Local development default: http://127.0.0.1:54321
# Hosted development: https://your-project-id.supabase.co
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Public Anon Key (SAFE for client distribution)
# Obtain from: `npx supabase status` (local) or Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_ANON_KEY=

# Server-Side Edge Function Secrets (NEVER expose to client)
# ----------------------------------------------------------
# Set on Supabase Edge Runtime via:
#   npx supabase secrets set GEMINI_API_KEY=your_key_here
#   npx supabase secrets set GEMINI_MODEL=gemini-2.5-flash
# Or place in `supabase/functions/.env` for local edge function development.
#
# DO NOT set VITE_GEMINI_API_KEY in client environment files.
# All Gemini AI requests must be proxied through the authenticated companion-gateway Edge Function.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# SECURITY NOTICE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY, or database credentials
# in client-facing source code, in `.env`, or in mobile application bundles.
